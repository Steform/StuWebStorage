### Symfony / Composer ###
/vendor/
/bin/*
!bin/console
!bin/symfony_requirements
!bin/prune-translations.php
!bin/reset-prod-cache
/composer.phar
/var/bootstrap.php.cache

### Runtime: cache, logs, sessions ###
/var/cache/*
!/var/cache/.gitkeep
/var/log/*
!/var/log/.gitkeep
/var/sessions/*
!/var/sessions/.gitkeep

### Runtime: encrypted user storage & temp uploads ###
/var/shared/*
!/var/shared/.gitkeep
/var/chunk_upload/*
!/var/chunk_upload/.gitkeep
/var/download_prepare/*
!/var/download_prepare/.gitkeep
/var/tasks/*
!/var/tasks/.gitkeep

### Local / test artefacts ###
/var/test/
/var/test.db
/prod.log
/.phpunit.cache/
/phpunit.xml
/build/
/.web-server-pid
composer.json.bak
**/*~

### IDE / local tooling ###
# Keep shared Cursor rules versioned; ignore the rest of .cursor/
/.cursor/*
!/.cursor/rules/
!/.cursor/rules/**
/.idea/
/.vscode/

### Environment files (never commit secrets) ###
/.env
/.env.local
/.env.dev
/.env.test
/.env.*.local
!/.env.exemple

### Local dev overrides (machine-specific) ###
/config/packages/dev/z_framework.local.yaml
