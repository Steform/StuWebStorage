{#
  Confirm dismiss of the upload modal while encryption is running.
  Continue in background is the primary action.
#}
<div class="modal fade" id="filesUploadEncryptDismissModal" tabindex="-1" aria-labelledby="filesUploadEncryptDismissModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="filesUploadEncryptDismissModalLabel">{{ 'files.tasks.dismiss_title'|trans({}, 'messages', currentLocale) }}</h2>
            </div>
            <div class="modal-body">
                <p class="mb-0">{{ 'files.tasks.dismiss_body'|trans({}, 'messages', currentLocale) }}</p>
            </div>
            <div class="modal-footer flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-files-encrypt-dismiss-stay>{{ 'files.tasks.dismiss_stay'|trans({}, 'messages', currentLocale) }}</button>
                <button type="button" class="btn btn-outline-danger" data-files-encrypt-dismiss-cancel>{{ 'files.tasks.dismiss_cancel'|trans({}, 'messages', currentLocale) }}</button>
                <button type="button" class="btn btn-primary" data-files-encrypt-dismiss-continue autofocus>{{ 'files.tasks.dismiss_continue'|trans({}, 'messages', currentLocale) }}</button>
            </div>
        </div>
    </div>
</div>
