{% extends 'base.html.twig' %}
{% set currentLocale = app.request.locale|default('fr') %}
{% block title %}{{ 'files.download_progress.page_title'|trans({}, 'messages', currentLocale) }}{% endblock %}
{% block main_container_class %}container py-4{% endblock %}
{% block body %}
<div
    id="files-download-progress-page"
    class="row justify-content-center"
    data-file-id="{{ sharedFile.id }}"
    data-file-bytes="{{ sharedFile.byteSize }}"
    data-file-name="{{ sharedFile.originalFileName|e('html_attr') }}"
    data-token-url="{{ tokenUrl|e('html_attr') }}"
    data-download-url="{{ downloadUrl|e('html_attr') }}"
    data-csrf-token="{{ csrf_token(csrfDownloadToken)|e('html_attr') }}"
    data-msg-error="{{ 'files.download_progress.error_generic'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-resume-prompt="{{ 'files.download_progress.resume_prompt'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-resume-picker-hint="{{ 'files.download_progress.resume_picker_hint'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-resume-opfs-info="{{ 'files.download_progress.resume_opfs_info'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-checkpoint-invalid="{{ 'files.download_progress.checkpoint_invalid'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-parallel-tab="{{ 'files.download_progress.parallel_tab'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-calculating="{{ 'files.download_progress.eta_calculating'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-remaining="{{ 'files.download_progress.eta_remaining'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-speed="{{ 'files.download_progress.eta_speed'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-line="{{ 'files.download_progress.eta_line'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-unit-s="{{ 'files.download_progress.eta_unit_s'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-unit-m="{{ 'files.download_progress.eta_unit_m'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-unit-h="{{ 'files.download_progress.eta_unit_h'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
>
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">{{ 'files.download_progress.page_title'|trans({}, 'messages', currentLocale) }}</h1>
                <p class="mb-2"><strong>{{ sharedFile.originalFileName }}</strong></p>
                <p class="text-body-secondary small mb-4">{{ 'files.download_progress.hint'|trans({}, 'messages', currentLocale) }}</p>
                <div id="files-download-progress-error" class="alert alert-danger d-none" role="alert"></div>
                <div id="files-download-resume-prompt" class="alert alert-warning d-none" role="region" aria-live="polite">
                    <p class="mb-2" id="files-download-resume-message"></p>
                    <p class="small mb-3 d-none" id="files-download-resume-picker-hint"></p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary" id="files-download-resume-btn">{{ 'files.download_progress.resume_btn'|trans({}, 'messages', currentLocale) }}</button>
                        <button type="button" class="btn btn-outline-secondary" id="files-download-restart-btn">{{ 'files.download_progress.restart_btn'|trans({}, 'messages', currentLocale) }}</button>
                    </div>
                </div>
                <div class="progress mb-2" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <div id="files-download-progress-bar" class="progress-bar" style="width: 0%"></div>
                </div>
                <p class="small text-muted mb-1" id="files-download-progress-count" aria-live="polite"></p>
                <p class="small text-muted mb-3" id="files-download-progress-eta" aria-live="polite"></p>
                <button type="button" class="btn btn-outline-secondary" id="files-download-progress-cancel">{{ 'files.download_progress.cancel'|trans({}, 'messages', currentLocale) }}</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block extra_scripts %}
    <script src="{{ asset('js/transfer-eta.js') }}?v=20261109c" defer></script>
    <script src="{{ asset('js/files-download-checkpoint.js') }}?v=20260707" defer></script>
    <script src="{{ asset('js/files-download-sinks.js') }}?v=20260707" defer></script>
    <script src="{{ asset('js/files-download-manager.js') }}?v=20260707" defer></script>
    <script src="{{ asset('js/files-download-progress-page.js') }}?v=20261109" defer></script>
{% endblock %}
