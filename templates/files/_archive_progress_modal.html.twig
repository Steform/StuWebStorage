<div class="modal fade" id="filesArchiveProgressModal" tabindex="-1" aria-labelledby="filesArchiveProgressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="filesArchiveProgressModalLabel">{{ 'files.archive.progress_title'|trans({}, 'messages', currentLocale) }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'app.close'|trans({}, 'messages', currentLocale) }}"></button>
            </div>
            <div class="modal-body">
                <p class="small text-body-secondary mb-3">{{ 'files.archive.progress_hint'|trans({}, 'messages', currentLocale) }}</p>
                <div class="progress mb-2" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <div id="files-archive-progress-bar" class="progress-bar" style="width: 0%"></div>
                </div>
                <p class="small text-muted mb-0" id="files-archive-progress-status" aria-live="polite"></p>
            </div>
        </div>
    </div>
</div>
