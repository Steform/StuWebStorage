<div
    class="modal fade"
    id="filesArchiveProgressModal"
    tabindex="-1"
    aria-labelledby="filesArchiveProgressModalLabel"
    aria-hidden="true"
    data-msg-eta-calculating="{{ 'files.archive.eta_calculating'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-remaining="{{ 'files.archive.eta_remaining'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-speed="{{ 'files.archive.eta_speed'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-line="{{ 'files.archive.eta_line'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-unit-s="{{ 'files.archive.eta_unit_s'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-unit-m="{{ 'files.archive.eta_unit_m'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-msg-eta-unit-h="{{ 'files.archive.eta_unit_h'|trans({}, 'messages', currentLocale)|e('html_attr') }}"
    data-ops-family="b"
    data-ops-modal-key="files_archive"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ops-modal-content">
            <div class="modal-header ops-modal-header">
                <h2 class="modal-title h5" id="filesArchiveProgressModalLabel">{{ 'files.archive.progress_title'|trans({}, 'messages', currentLocale) }}</h2>
                {% include 'operations/_operation_header_actions.html.twig' with { close_aria: 'app.close'|trans({}, 'messages', currentLocale) } %}
            </div>
            <div class="modal-body ops-modal-body">
                <p class="small text-body-secondary mb-3">{{ 'files.archive.progress_hint'|trans({}, 'messages', currentLocale) }}</p>
                <div class="progress mb-2" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <div id="files-archive-progress-bar" class="progress-bar" style="width: 0%"></div>
                </div>
                <p class="small text-muted mb-1" id="files-archive-progress-status" aria-live="polite"></p>
                <p class="small text-muted mb-0" id="files-archive-progress-eta" aria-live="polite"></p>
            </div>
            <div class="modal-footer ops-modal-footer">
                <button type="button" class="btn btn-outline-danger" data-ops-cancel>{{ 'files.ops.cancel'|trans({}, 'messages', currentLocale) }}</button>
            </div>
        </div>
    </div>
</div>
